<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- PyInstaller bootstraps Python by mapping unsigned executable pages,
         and torch/numpy load dylibs signed by other teams: both are blocked
         by the hardened runtime without these exceptions. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Microphone capture for audio-reactive visuals (sounddevice). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
